{
	"name": "mehran-mrn/anar-login",
	"description": "Passwordless WordPress login with Iranian SMS providers, email OTP and Google OAuth.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"squizlabs/php_codesniffer": "^3.10",
		"wp-coding-standards/wpcs": "^3.1",
		"phpcompatibility/php-compatibility": "^9.3"
	},
	"autoload": {
		"psr-4": {
			"Anar\\Login\\": "src/"
		}
	},
	"scripts": {
		"test": "phpunit",
		"phpcs": "phpcs -q"
	},
	"config": {
		"sort-packages": true,
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
