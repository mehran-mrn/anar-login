{
  "Store settings": "\u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u0641\u0631\u0648\u0634\u06af\u0627\u0647",
  "Connection and orders": "\u0627\u062a\u0635\u0627\u0644 \u0648 \u0633\u0641\u0627\u0631\u0634\u200c\u0647\u0627",
  "Order messages and connection": "\u067e\u06cc\u0627\u0645\u200c\u0647\u0627\u06cc \u0633\u0641\u0627\u0631\u0634 \u0648 \u0627\u062a\u0635\u0627\u0644 \u067e\u0646\u0644",
  "Use the sign-in SMS provider": "\u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u067e\u0646\u0644 \u067e\u06cc\u0627\u0645\u06a9\u06cc \u0648\u0631\u0648\u062f",
  "Cart recovery and sending limits": "\u0628\u0627\u0632\u06cc\u0627\u0628\u06cc \u0633\u0628\u062f \u0648 \u0645\u062d\u062f\u0648\u062f\u06cc\u062a\u200c\u0647\u0627\u06cc \u0627\u0631\u0633\u0627\u0644",
  "Maximum discount including tax (0 = unlimited)": "\u062d\u062f\u0627\u06a9\u062b\u0631 \u0645\u0628\u0644\u063a \u062a\u062e\u0641\u06cc\u0641 \u0628\u0627 \u0627\u062d\u062a\u0633\u0627\u0628 \u0645\u0627\u0644\u06cc\u0627\u062a (\u06f0 = \u0628\u062f\u0648\u0646 \u0633\u0642\u0641)",
  "Capped recovery discounts require WooCommerce 8.8 or newer.": "\u062a\u062e\u0641\u06cc\u0641 \u0633\u0642\u0641\u200c\u062f\u0627\u0631 \u0628\u0627\u0632\u06cc\u0627\u0628\u06cc \u0628\u0647 \u0648\u0648\u06a9\u0627\u0645\u0631\u0633 \u06f8.\u06f8 \u06cc\u0627 \u062c\u062f\u06cc\u062f\u062a\u0631 \u0646\u06cc\u0627\u0632 \u062f\u0627\u0631\u062f.",
  "Anar account button": "\u062f\u06a9\u0645\u0647 \u0648\u0631\u0648\u062f \u0648 \u062d\u0633\u0627\u0628 \u06a9\u0627\u0631\u0628\u0631\u06cc \u0627\u0646\u0627\u0631",
  "Anar cart recovery": "\u0628\u0627\u0632\u06cc\u0627\u0628\u06cc \u0633\u0628\u062f \u062e\u0631\u06cc\u062f \u0627\u0646\u0627\u0631",
  "Content": "\u0645\u062d\u062a\u0648\u0627",
  "Sign in / Account": "\u0648\u0631\u0648\u062f / \u062d\u0633\u0627\u0628 \u06a9\u0627\u0631\u0628\u0631\u06cc",
  "Enable this feature in Anar settings.": "\u0627\u06cc\u0646 \u0642\u0627\u0628\u0644\u06cc\u062a \u0631\u0627 \u062f\u0631 \u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u0627\u0646\u0627\u0631 \u0641\u0639\u0627\u0644 \u06a9\u0646\u06cc\u062f.",
  "Bale supports verification codes only.": "\u0628\u0644\u0647 \u0641\u0642\u0637 \u0627\u0632 \u0627\u0631\u0633\u0627\u0644 \u06a9\u062f \u062a\u0623\u06cc\u06cc\u062f \u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u06cc \u0645\u06cc\u200c\u06a9\u0646\u062f.",
  "Bale OTP": "\u06a9\u062f \u0648\u0631\u0648\u062f \u062f\u0631 \u0628\u0644\u0647",
  "Receive verification codes inside Bale.": "\u06a9\u062f \u062a\u0623\u06cc\u06cc\u062f \u0631\u0627 \u062f\u0631 \u067e\u06cc\u0627\u0645\u200c\u0631\u0633\u0627\u0646 \u0628\u0644\u0647 \u062f\u0631\u06cc\u0627\u0641\u062a \u06a9\u0646\u06cc\u062f.",
  "Client ID": "\u0634\u0646\u0627\u0633\u0647 \u0645\u0634\u062a\u0631\u06cc \u0628\u0644\u0647",
  "Client secret": "\u0631\u0645\u0632 \u0627\u062a\u0635\u0627\u0644 \u0628\u0644\u0647",
  "Bale authentication failed.": "\u0627\u062d\u0631\u0627\u0632 \u0647\u0648\u06cc\u062a \u067e\u0646\u0644 \u0628\u0644\u0647 \u0627\u0646\u062c\u0627\u0645 \u0646\u0634\u062f.",
  "Bale could not deliver the verification code.": "\u0628\u0644\u0647 \u0646\u062a\u0648\u0627\u0646\u0633\u062a \u06a9\u062f \u062a\u0623\u06cc\u06cc\u062f \u0631\u0627 \u0627\u0631\u0633\u0627\u0644 \u06a9\u0646\u062f.",
  "You cannot preview invoices.": "\u0634\u0645\u0627 \u0627\u062c\u0627\u0632\u0647 \u067e\u06cc\u0634\u200c\u0646\u0645\u0627\u06cc\u0634 \u0641\u0627\u06a9\u062a\u0648\u0631 \u0631\u0627 \u0646\u062f\u0627\u0631\u06cc\u062f.",
  "Order not found.": "\u0633\u0641\u0627\u0631\u0634 \u067e\u06cc\u062f\u0627 \u0646\u0634\u062f.",
  "Sample customer": "\u0645\u0634\u062a\u0631\u06cc \u0646\u0645\u0648\u0646\u0647",
  "Sample address": "\u0646\u0634\u0627\u0646\u06cc \u0646\u0645\u0648\u0646\u0647",
  "Sample product": "\u06a9\u0627\u0644\u0627\u06cc \u0646\u0645\u0648\u0646\u0647",
  "Invoice template": "\u0642\u0627\u0644\u0628 \u0641\u0627\u06a9\u062a\u0648\u0631",
  "Branded": "\u0628\u0631\u0646\u062f\u062f\u0627\u0631",
  "Simple print": "\u0633\u0627\u062f\u0647 \u0648 \u0645\u0646\u0627\u0633\u0628 \u0686\u0627\u067e",
  "Accent color": "\u0631\u0646\u06af \u0627\u0635\u0644\u06cc",
  "Logo URL": "\u0646\u0634\u0627\u0646\u06cc \u062a\u0635\u0648\u06cc\u0631 \u0644\u0648\u06af\u0648",
  "Invoice footer": "\u0645\u062a\u0646 \u067e\u0627\u06cc\u06cc\u0646 \u0641\u0627\u06a9\u062a\u0648\u0631",
  "Show product SKU": "\u0646\u0645\u0627\u06cc\u0634 \u0634\u0646\u0627\u0633\u0647 \u06a9\u0627\u0644\u0627",
  "Show shipping address": "\u0646\u0645\u0627\u06cc\u0634 \u0646\u0634\u0627\u0646\u06cc \u0627\u0631\u0633\u0627\u0644",
  "Show customer note": "\u0646\u0645\u0627\u06cc\u0634 \u06cc\u0627\u062f\u062f\u0627\u0634\u062a \u0645\u0634\u062a\u0631\u06cc",
  "Preview saved invoice settings": "\u067e\u06cc\u0634\u200c\u0646\u0645\u0627\u06cc\u0634 \u0641\u0627\u06a9\u062a\u0648\u0631 \u0628\u0627 \u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u0630\u062e\u06cc\u0631\u0647\u200c\u0634\u062f\u0647",
  "Preview order ID (empty = sample)": "\u0634\u0646\u0627\u0633\u0647 \u0633\u0641\u0627\u0631\u0634 \u0628\u0631\u0627\u06cc \u067e\u06cc\u0634\u200c\u0646\u0645\u0627\u06cc\u0634 (\u062e\u0627\u0644\u06cc = \u0646\u0645\u0648\u0646\u0647)",
  "Verification code sent via Bale.": "\u06a9\u062f \u062a\u0623\u06cc\u06cc\u062f \u062f\u0631 \u067e\u06cc\u0627\u0645\u200c\u0631\u0633\u0627\u0646 \u0628\u0644\u0647 \u0627\u0631\u0633\u0627\u0644 \u0634\u062f.",
  "Recovery sending starts at hour (0-23)": "\u0633\u0627\u0639\u062a \u0634\u0631\u0648\u0639 \u0627\u0631\u0633\u0627\u0644 \u06cc\u0627\u062f\u0622\u0648\u0631\u06cc (\u06f0 \u062a\u0627 \u06f2\u06f3)",
  "Recovery sending stops at hour (1-24)": "\u0633\u0627\u0639\u062a \u067e\u0627\u06cc\u0627\u0646 \u0627\u0631\u0633\u0627\u0644 \u06cc\u0627\u062f\u0622\u0648\u0631\u06cc (\u06f1 \u062a\u0627 \u06f2\u06f4)",
  "Maximum reminders per phone in 24 hours (1-10)": "\u0633\u0642\u0641 \u06cc\u0627\u062f\u0622\u0648\u0631\u06cc \u0647\u0631 \u0634\u0645\u0627\u0631\u0647 \u062f\u0631 \u06f2\u06f4 \u0633\u0627\u0639\u062a (\u06f1 \u062a\u0627 \u06f1\u06f0)",
  "Recovery link lifetime after cart activity, days (1-30)": "\u0627\u0639\u062a\u0628\u0627\u0631 \u0644\u06cc\u0646\u06a9 \u0628\u0627\u0632\u06cc\u0627\u0628\u06cc \u067e\u0633 \u0627\u0632 \u0641\u0639\u0627\u0644\u06cc\u062a \u0633\u0628\u062f\u060c \u0628\u0647 \u0631\u0648\u0632 (\u06f1 \u062a\u0627 \u06f3\u06f0)",
  "Local data retention, days (7-90)": "\u0645\u062f\u062a \u0646\u06af\u0647\u062f\u0627\u0631\u06cc \u062f\u0627\u062f\u0647\u200c\u0647\u0627\u06cc \u0645\u062d\u0644\u06cc\u060c \u0628\u0647 \u0631\u0648\u0632 (\u06f7 \u062a\u0627 \u06f9\u06f0)",
  "If you opt into purchase reminders, we store your mobile number, optional email, consent text and timestamp, cart products, amount, currency and related order ID locally. We send your number and the configured reminder variables (which may include purchase links and order details) to our selected SMS provider. Each reminder includes a link to stop future cart and unpaid-order reminders. Payment notifications are separate service messages. Reminder links restore products or open WooCommerce payment; they do not log you in. The store configures a 7-90 day retention period and SMS provider. Add the selected provider, its terms and privacy links, your actual retention period and the purposes of your messages to this policy before enabling the modules.": "\u0628\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u062f\u0631\u06cc\u0627\u0641\u062a \u06cc\u0627\u062f\u0622\u0648\u0631\u06cc \u062e\u0631\u06cc\u062f\u060c \u0634\u0645\u0627\u0631\u0647 \u0645\u0648\u0628\u0627\u06cc\u0644\u060c \u0627\u06cc\u0645\u06cc\u0644 \u0627\u062e\u062a\u06cc\u0627\u0631\u06cc\u060c \u0645\u062a\u0646 \u0648 \u0632\u0645\u0627\u0646 \u0631\u0636\u0627\u06cc\u062a\u060c \u0645\u062d\u0635\u0648\u0644\u0627\u062a \u0633\u0628\u062f\u060c \u0645\u0628\u0644\u063a\u060c \u0627\u0631\u0632 \u0648 \u0634\u0646\u0627\u0633\u0647 \u0633\u0641\u0627\u0631\u0634 \u0645\u0631\u062a\u0628\u0637 \u062f\u0631 \u0633\u0627\u06cc\u062a \u0630\u062e\u06cc\u0631\u0647 \u0645\u06cc\u200c\u0634\u0648\u0646\u062f. \u0634\u0645\u0627\u0631\u0647 \u0648 \u0645\u062a\u063a\u06cc\u0631\u0647\u0627\u06cc \u067e\u06cc\u06a9\u0631\u0628\u0646\u062f\u06cc\u200c\u0634\u062f\u0647 \u06cc\u0627\u062f\u0622\u0648\u0631\u06cc\u060c \u0634\u0627\u0645\u0644 \u0644\u06cc\u0646\u06a9 \u062e\u0631\u06cc\u062f \u06cc\u0627 \u062c\u0632\u0626\u06cc\u0627\u062a \u0633\u0641\u0627\u0631\u0634\u060c \u0628\u0647 \u0633\u0631\u0648\u06cc\u0633 \u067e\u06cc\u0627\u0645\u06a9\u06cc \u0645\u0646\u062a\u062e\u0628 \u0627\u0631\u0633\u0627\u0644 \u0645\u06cc\u200c\u0634\u0648\u0646\u062f. \u0647\u0631 \u067e\u06cc\u0627\u0645 \u0644\u06cc\u0646\u06a9 \u062a\u0648\u0642\u0641 \u06cc\u0627\u062f\u0622\u0648\u0631\u06cc \u0633\u0628\u062f \u0648 \u0633\u0641\u0627\u0631\u0634 \u067e\u0631\u062f\u0627\u062e\u062a\u200c\u0646\u0634\u062f\u0647 \u062f\u0627\u0631\u062f. \u0627\u0639\u0644\u0627\u0646 \u067e\u0631\u062f\u0627\u062e\u062a \u067e\u06cc\u0627\u0645 \u062e\u062f\u0645\u0627\u062a\u06cc \u062c\u062f\u0627\u06af\u0627\u0646\u0647\u200c\u0627\u06cc \u0627\u0633\u062a. \u0644\u06cc\u0646\u06a9 \u06cc\u0627\u062f\u0622\u0648\u0631\u06cc\u060c \u0633\u0628\u062f \u0631\u0627 \u0628\u0627\u0632\u06cc\u0627\u0628\u06cc \u06cc\u0627 \u067e\u0631\u062f\u0627\u062e\u062a \u0648\u0648\u06a9\u0627\u0645\u0631\u0633 \u0631\u0627 \u0628\u0627\u0632 \u0645\u06cc\u200c\u06a9\u0646\u062f \u0648 \u0628\u0627\u0639\u062b \u0648\u0631\u0648\u062f \u0628\u0647 \u062d\u0633\u0627\u0628 \u0646\u0645\u06cc\u200c\u0634\u0648\u062f. \u0645\u062f\u06cc\u0631 \u0641\u0631\u0648\u0634\u06af\u0627\u0647 \u0645\u062f\u062a \u0646\u06af\u0647\u062f\u0627\u0631\u06cc \u06f7 \u062a\u0627 \u06f9\u06f0 \u0631\u0648\u0632 \u0648 \u0633\u0631\u0648\u06cc\u0633 \u067e\u06cc\u0627\u0645\u06a9\u06cc \u0631\u0627 \u062a\u0646\u0638\u06cc\u0645 \u0645\u06cc\u200c\u06a9\u0646\u062f. \u067e\u06cc\u0634 \u0627\u0632 \u0641\u0639\u0627\u0644\u200c\u0633\u0627\u0632\u06cc\u060c \u0646\u0627\u0645 \u0633\u0631\u0648\u06cc\u0633\u060c \u0644\u06cc\u0646\u06a9 \u0634\u0631\u0627\u06cc\u0637 \u0648 \u062d\u0631\u06cc\u0645 \u062e\u0635\u0648\u0635\u06cc\u060c \u0645\u062f\u062a \u0648\u0627\u0642\u0639\u06cc \u0646\u06af\u0647\u062f\u0627\u0631\u06cc \u0648 \u0647\u062f\u0641 \u067e\u06cc\u0627\u0645\u200c\u0647\u0627 \u0631\u0627 \u0628\u0647 \u0627\u06cc\u0646 \u0633\u06cc\u0627\u0633\u062a \u0627\u0636\u0627\u0641\u0647 \u06a9\u0646\u06cc\u062f.",
  "Recovery eligibility after cart activity, days (1-30)": "\u0645\u0647\u0644\u062a \u0628\u0627\u0632\u06cc\u0627\u0628\u06cc \u067e\u0633 \u0627\u0632 \u0641\u0639\u0627\u0644\u06cc\u062a \u0633\u0628\u062f\u060c \u0628\u0647 \u0631\u0648\u0632 (\u06f1 \u062a\u0627 \u06f3\u06f0)",
  "Recovery code validity, minutes (5-1440)": "\u0627\u0639\u062a\u0628\u0627\u0631 \u06a9\u062f \u0628\u0627\u0632\u06cc\u0627\u0628\u06cc\u060c \u0628\u0647 \u062f\u0642\u06cc\u0642\u0647 (\u06f5 \u062a\u0627 \u06f1\u06f4\u06f4\u06f0)",
  "If you opt into purchase reminders, we store your mobile number, optional email, consent text and timestamp, cart products, amount, currency and related order ID locally. We send your number and the configured reminder variables (which may include purchase links and order details) to our selected SMS provider. Each reminder includes a link to stop future cart and unpaid-order reminders. Payment notifications are separate service messages. Phone-bound, single-use recovery codes restore products or open WooCommerce payment; they do not log you in. Recovery code hashes, attempts, expiry and consumption timestamps are stored separately from login challenges. Unsubscribe links only stop purchase reminders. The store configures a 7-90 day retention period and SMS provider. Add the selected provider, its terms and privacy links, your actual retention period and the purposes of your messages to this policy before enabling the modules.": "\u0628\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u062f\u0631\u06cc\u0627\u0641\u062a \u06cc\u0627\u062f\u0622\u0648\u0631\u06cc \u062e\u0631\u06cc\u062f\u060c \u0634\u0645\u0627\u0631\u0647 \u0645\u0648\u0628\u0627\u06cc\u0644\u060c \u0627\u06cc\u0645\u06cc\u0644 \u0627\u062e\u062a\u06cc\u0627\u0631\u06cc\u060c \u0645\u062a\u0646 \u0648 \u0632\u0645\u0627\u0646 \u0631\u0636\u0627\u06cc\u062a\u060c \u0645\u062d\u0635\u0648\u0644\u0627\u062a \u0633\u0628\u062f\u060c \u0645\u0628\u0644\u063a\u060c \u0627\u0631\u0632 \u0648 \u0634\u0646\u0627\u0633\u0647 \u0633\u0641\u0627\u0631\u0634 \u0645\u0631\u062a\u0628\u0637 \u062f\u0631 \u0633\u0627\u06cc\u062a \u0630\u062e\u06cc\u0631\u0647 \u0645\u06cc\u200c\u0634\u0648\u0646\u062f. \u0634\u0645\u0627\u0631\u0647 \u0648 \u0645\u062a\u063a\u06cc\u0631\u0647\u0627\u06cc \u067e\u06cc\u06a9\u0631\u0628\u0646\u062f\u06cc\u200c\u0634\u062f\u0647 \u06cc\u0627\u062f\u0622\u0648\u0631\u06cc\u060c \u0634\u0627\u0645\u0644 \u0644\u06cc\u0646\u06a9 \u062e\u0631\u06cc\u062f \u06cc\u0627 \u062c\u0632\u0626\u06cc\u0627\u062a \u0633\u0641\u0627\u0631\u0634\u060c \u0628\u0647 \u0633\u0631\u0648\u06cc\u0633 \u067e\u06cc\u0627\u0645\u06a9\u06cc \u0645\u0646\u062a\u062e\u0628 \u0627\u0631\u0633\u0627\u0644 \u0645\u06cc\u200c\u0634\u0648\u0646\u062f. \u0647\u0631 \u067e\u06cc\u0627\u0645 \u0644\u06cc\u0646\u06a9 \u062a\u0648\u0642\u0641 \u06cc\u0627\u062f\u0622\u0648\u0631\u06cc \u0633\u0628\u062f \u0648 \u0633\u0641\u0627\u0631\u0634 \u067e\u0631\u062f\u0627\u062e\u062a\u200c\u0646\u0634\u062f\u0647 \u062f\u0627\u0631\u062f. \u0627\u0639\u0644\u0627\u0646 \u067e\u0631\u062f\u0627\u062e\u062a \u067e\u06cc\u0627\u0645 \u062e\u062f\u0645\u0627\u062a\u06cc \u062c\u062f\u0627\u06af\u0627\u0646\u0647\u200c\u0627\u06cc \u0627\u0633\u062a. \u06a9\u062f \u06cc\u06a9\u200c\u0628\u0627\u0631\u0645\u0635\u0631\u0641 \u0645\u062a\u0635\u0644 \u0628\u0647 \u0634\u0645\u0627\u0631\u0647\u060c \u0633\u0628\u062f \u0631\u0627 \u0628\u0627\u0632\u06cc\u0627\u0628\u06cc \u06cc\u0627 \u067e\u0631\u062f\u0627\u062e\u062a \u0648\u0648\u06a9\u0627\u0645\u0631\u0633 \u0631\u0627 \u0628\u0627\u0632 \u0645\u06cc\u200c\u06a9\u0646\u062f \u0648 \u0628\u0627\u0639\u062b \u0648\u0631\u0648\u062f \u0628\u0647 \u062d\u0633\u0627\u0628 \u0646\u0645\u06cc\u200c\u0634\u0648\u062f. \u0647\u0634 \u06a9\u062f\u060c \u062a\u0639\u062f\u0627\u062f \u062a\u0644\u0627\u0634\u060c \u0627\u0646\u0642\u0636\u0627 \u0648 \u0632\u0645\u0627\u0646 \u0645\u0635\u0631\u0641 \u0645\u0633\u062a\u0642\u0644 \u0627\u0632 \u06a9\u062f\u0647\u0627\u06cc \u0648\u0631\u0648\u062f \u0630\u062e\u06cc\u0631\u0647 \u0645\u06cc\u200c\u0634\u0648\u0646\u062f. \u0644\u06cc\u0646\u06a9 \u0644\u063a\u0648 \u0641\u0642\u0637 \u06cc\u0627\u062f\u0622\u0648\u0631\u06cc \u062e\u0631\u06cc\u062f \u0631\u0627 \u0645\u062a\u0648\u0642\u0641 \u0645\u06cc\u200c\u06a9\u0646\u062f. \u0645\u062f\u06cc\u0631 \u0641\u0631\u0648\u0634\u06af\u0627\u0647 \u0645\u062f\u062a \u0646\u06af\u0647\u062f\u0627\u0631\u06cc \u06f7 \u062a\u0627 \u06f9\u06f0 \u0631\u0648\u0632 \u0648 \u0633\u0631\u0648\u06cc\u0633 \u067e\u06cc\u0627\u0645\u06a9\u06cc \u0631\u0627 \u062a\u0646\u0638\u06cc\u0645 \u0645\u06cc\u200c\u06a9\u0646\u062f. \u067e\u06cc\u0634 \u0627\u0632 \u0641\u0639\u0627\u0644\u200c\u0633\u0627\u0632\u06cc\u060c \u0646\u0627\u0645 \u0633\u0631\u0648\u06cc\u0633\u060c \u0644\u06cc\u0646\u06a9 \u0634\u0631\u0627\u06cc\u0637 \u0648 \u062d\u0631\u06cc\u0645 \u062e\u0635\u0648\u0635\u06cc\u060c \u0645\u062f\u062a \u0648\u0627\u0642\u0639\u06cc \u0646\u06af\u0647\u062f\u0627\u0631\u06cc \u0648 \u0647\u062f\u0641 \u067e\u06cc\u0627\u0645\u200c\u0647\u0627 \u0631\u0627 \u0628\u0647 \u0627\u06cc\u0646 \u0633\u06cc\u0627\u0633\u062a \u0627\u0636\u0627\u0641\u0647 \u06a9\u0646\u06cc\u062f.",
  "Offer from reminder stage (1-3)": "\u0627\u0631\u0627\u0626\u0647\u0654 \u062a\u062e\u0641\u06cc\u0641 \u0627\u0632 \u0645\u0631\u062d\u0644\u0647\u0654 \u06cc\u0627\u062f\u0622\u0648\u0631\u06cc (\u06f1 \u062a\u0627 \u06f3)",
  "Correct quiz option (1-8)": "\u06af\u0632\u06cc\u0646\u0647\u0654 \u062f\u0631\u0633\u062a \u0645\u0633\u0627\u0628\u0642\u0647 (\u06f1 \u062a\u0627 \u06f8)",
  "When purchase reminders are enabled, automatic capture saves your account/checkout phone and cart without a separate checkbox and shows a notice. An optional explicit preference form is also available. We store your mobile number, optional email, consent text and timestamp, cart products, amount, currency and related order ID locally. We send your number and the configured reminder variables (which may include purchase links and order details) to our selected SMS provider. Each reminder includes a link to stop future cart and unpaid-order reminders. Payment notifications are separate service messages. Phone-bound, single-use recovery codes restore products or open WooCommerce payment; they do not log you in. Recovery code hashes, attempts, expiry and consumption timestamps are stored separately from login challenges. Unsubscribe links stop purchase reminders and optional marketing campaigns; service notices are separate. A keyed suppression identifier is retained after erasure. The store configures a 7-90 day retention period and SMS provider. Add the selected provider, its terms and privacy links, your actual retention period and the purposes of your messages to this policy before enabling the modules.": "\u0628\u0627 \u0641\u0639\u0627\u0644 \u0634\u062f\u0646 \u06cc\u0627\u062f\u0622\u0648\u0631\u06cc \u062e\u0631\u06cc\u062f\u060c \u062d\u0627\u0644\u062a \u062e\u0648\u062f\u06a9\u0627\u0631 \u0634\u0645\u0627\u0631\u0647\u0654 \u062d\u0633\u0627\u0628 \u06cc\u0627 \u062a\u0633\u0648\u06cc\u0647\u200c\u062d\u0633\u0627\u0628 \u0648 \u0633\u0628\u062f \u0631\u0627 \u0628\u062f\u0648\u0646 \u062a\u06cc\u06a9 \u062c\u062f\u0627\u06af\u0627\u0646\u0647 \u0648 \u0628\u0627 \u0646\u0645\u0627\u06cc\u0634 \u0627\u0637\u0644\u0627\u0639\u06cc\u0647 \u0630\u062e\u06cc\u0631\u0647 \u0645\u06cc\u200c\u06a9\u0646\u062f. \u062d\u0627\u0644\u062a \u0627\u062e\u062a\u06cc\u0627\u0631\u06cc \u0641\u0631\u0645 \u062c\u062f\u0627\u06af\u0627\u0646\u0647 \u0646\u06cc\u0632 \u0648\u062c\u0648\u062f \u062f\u0627\u0631\u062f. \u0634\u0645\u0627\u0631\u0647\u0654 \u0647\u0645\u0631\u0627\u0647\u060c \u0627\u06cc\u0645\u06cc\u0644 \u0627\u062e\u062a\u06cc\u0627\u0631\u06cc\u060c \u0645\u062a\u0646 \u0648 \u0632\u0645\u0627\u0646 \u0627\u0646\u062a\u062e\u0627\u0628 \u0635\u0631\u06cc\u062d\u060c \u06a9\u0627\u0644\u0627\u0647\u0627\u06cc \u0633\u0628\u062f\u060c \u0645\u0628\u0644\u063a\u060c \u0627\u0631\u0632 \u0648 \u0634\u0646\u0627\u0633\u0647\u0654 \u0633\u0641\u0627\u0631\u0634 \u0645\u0631\u0628\u0648\u0637 \u0645\u062d\u0644\u06cc \u0646\u06af\u0647\u062f\u0627\u0631\u06cc \u0645\u06cc\u200c\u0634\u0648\u0646\u062f. \u0634\u0645\u0627\u0631\u0647 \u0648 \u0645\u062a\u063a\u06cc\u0631\u0647\u0627\u06cc \u067e\u06cc\u0627\u0645\u060c \u0634\u0627\u0645\u0644 \u067e\u06cc\u0648\u0646\u062f \u062e\u0631\u06cc\u062f \u0648 \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0633\u0641\u0627\u0631\u0634\u060c \u0628\u0647 \u0633\u0631\u0648\u06cc\u0633\u200c\u062f\u0647\u0646\u062f\u0647\u0654 \u0627\u0646\u062a\u062e\u0627\u0628\u200c\u0634\u062f\u0647 \u0641\u0631\u0633\u062a\u0627\u062f\u0647 \u0645\u06cc\u200c\u0634\u0648\u0646\u062f. \u0647\u0631 \u06cc\u0627\u062f\u0622\u0648\u0631\u06cc \u067e\u06cc\u0648\u0646\u062f \u062a\u0648\u0642\u0641 \u067e\u06cc\u0627\u0645\u200c\u0647\u0627\u06cc \u0628\u0639\u062f\u06cc \u062f\u0627\u0631\u062f. \u0627\u0639\u0644\u0627\u0646\u200c\u0647\u0627\u06cc \u067e\u0631\u062f\u0627\u062e\u062a \u067e\u06cc\u0627\u0645 \u062e\u062f\u0645\u0627\u062a\u06cc \u0645\u0633\u062a\u0642\u0644\u200c\u0627\u0646\u062f. \u06a9\u062f \u0628\u0627\u0632\u06cc\u0627\u0628\u06cc \u06cc\u06a9\u200c\u0628\u0627\u0631\u0645\u0635\u0631\u0641 \u0648 \u0645\u062d\u062f\u0648\u062f \u0628\u0647 \u0634\u0645\u0627\u0631\u0647\u060c \u0641\u0642\u0637 \u06a9\u0627\u0644\u0627\u0647\u0627 \u06cc\u0627 \u067e\u0631\u062f\u0627\u062e\u062a \u0648\u0648\u06a9\u0627\u0645\u0631\u0633 \u0631\u0627 \u0628\u0627\u0632\u06cc\u0627\u0628\u06cc \u0645\u06cc\u200c\u06a9\u0646\u062f \u0648 \u0648\u0631\u0648\u062f \u0628\u0647 \u062d\u0633\u0627\u0628 \u0646\u06cc\u0633\u062a. \u0647\u0634 \u06a9\u062f\u060c \u062a\u0644\u0627\u0634\u200c\u0647\u0627\u060c \u0627\u0646\u0642\u0636\u0627 \u0648 \u0632\u0645\u0627\u0646 \u0645\u0635\u0631\u0641 \u0627\u0632 \u06a9\u062f\u0647\u0627\u06cc \u0648\u0631\u0648\u062f \u062c\u062f\u0627 \u0646\u06af\u0647\u062f\u0627\u0631\u06cc \u0645\u06cc\u200c\u0634\u0648\u0646\u062f. \u0644\u063a\u0648 \u062f\u0631\u06cc\u0627\u0641\u062a\u060c \u06cc\u0627\u062f\u0622\u0648\u0631\u06cc \u062e\u0631\u06cc\u062f \u0648 \u06a9\u0645\u067e\u06cc\u0646\u200c\u0647\u0627\u06cc \u0627\u062e\u062a\u06cc\u0627\u0631\u06cc \u0628\u0627\u0632\u0627\u0631\u06cc\u0627\u0628\u06cc \u0631\u0627 \u0645\u062a\u0648\u0642\u0641 \u0645\u06cc\u200c\u06a9\u0646\u062f\u061b \u067e\u06cc\u0627\u0645\u200c\u0647\u0627\u06cc \u062e\u062f\u0645\u0627\u062a\u06cc \u0645\u0633\u062a\u0642\u0644\u200c\u0627\u0646\u062f. \u067e\u0633 \u0627\u0632 \u062d\u0630\u0641 \u0647\u0648\u06cc\u062a\u060c \u06cc\u06a9 \u0634\u0646\u0627\u0633\u0647\u0654 \u06a9\u0644\u06cc\u062f\u062f\u0627\u0631 \u0628\u0631\u0627\u06cc \u062d\u0641\u0638 \u0644\u063a\u0648 \u067e\u06cc\u0627\u0645 \u0628\u0627\u0642\u06cc \u0645\u06cc\u200c\u0645\u0627\u0646\u062f. \u0641\u0631\u0648\u0634\u06af\u0627\u0647 \u0633\u0631\u0648\u06cc\u0633\u200c\u062f\u0647\u0646\u062f\u0647 \u0648 \u062f\u0648\u0631\u0647\u0654 \u0646\u06af\u0647\u062f\u0627\u0631\u06cc \u06f7 \u062a\u0627 \u06f9\u06f0 \u0631\u0648\u0632 \u0631\u0627 \u062a\u0639\u06cc\u06cc\u0646 \u0645\u06cc\u200c\u06a9\u0646\u062f. \u067e\u06cc\u0634 \u0627\u0632 \u0641\u0639\u0627\u0644\u200c\u0633\u0627\u0632\u06cc\u060c \u0646\u0627\u0645 \u0633\u0631\u0648\u06cc\u0633\u060c \u067e\u06cc\u0648\u0646\u062f \u0634\u0631\u0627\u06cc\u0637 \u0648 \u062d\u0631\u06cc\u0645 \u062e\u0635\u0648\u0635\u06cc \u0622\u0646\u060c \u0645\u062f\u062a \u0646\u06af\u0647\u062f\u0627\u0631\u06cc \u0648\u0627\u0642\u0639\u06cc \u0648 \u0627\u0647\u062f\u0627\u0641 \u067e\u06cc\u0627\u0645\u200c\u0647\u0627 \u0631\u0627 \u0628\u0647 \u0627\u06cc\u0646 \u0633\u06cc\u0627\u0633\u062a \u0627\u0636\u0627\u0641\u0647 \u06a9\u0646\u06cc\u062f.",
  "Anar Toolkit - SMS Login, Recovery & Marketing for WooCommerce": "\u062c\u0639\u0628\u0647\u200c\u0627\u0628\u0632\u0627\u0631 \u0627\u0646\u0627\u0631 \u2014 \u0648\u0631\u0648\u062f \u067e\u06cc\u0627\u0645\u06a9\u06cc\u060c \u0628\u0627\u0632\u06cc\u0627\u0628\u06cc \u062e\u0631\u06cc\u062f \u0648 \u0628\u0627\u0632\u0627\u0631\u06cc\u0627\u0628\u06cc \u0648\u0648\u06a9\u0627\u0645\u0631\u0633",
  "Capped recovery discount": "\u062a\u062e\u0641\u06cc\u0641 \u0633\u0642\u0641\u200c\u062f\u0627\u0631 \u0628\u0627\u0632\u06cc\u0627\u0628\u06cc"
}