msgstr "درگاه‌های الگویی فقط از مقدار {code} استفاده می‌کنند؛ این متن برای توسعه‌دهندگان و درگاه‌های متنی آماده است."

msgid "Tests the provider and details currently entered above, even before saving. The provider’s exact response is shown if delivery fails."
msgstr "درگاه و اطلاعاتی که همین الان در بالا وارد کرده‌اید آزمایش می‌شود، حتی پیش از ذخیره. در صورت خطا، پاسخ دقیق سرویس پیامک نمایش داده می‌شود."

msgid "Thank you for being one of our valued regular customers."
msgstr "ممنونیم که از مشتریان همیشگی و ارزشمند ما هستید."

msgid "Thank you for your first purchase."
msgstr "از اولین خرید شما سپاسگزاریم."

msgid "Thank you for your honest feedback."
msgstr "از بازخورد صادقانهٔ شما سپاسگزاریم."

msgid "Thanks for playing. No gift this time — see you next time!"
msgstr "از بازی شما ممنونیم. این بار هدیه‌ای نبود؛ به امید دیدار دوباره!"

msgid "The %s provider settings are incomplete."
msgstr "تنظیمات درگاه %s کامل نیست."

msgid "The Google account email is not verified."
msgstr "ایمیل حساب گوگل تأیید نشده است."

msgid "The Google account information is incomplete."
msgstr "اطلاعات حساب گوگل کامل نیست."

msgid "The Google sign-in request is invalid or has expired."
msgstr "درخواست ورود گوگل معتبر نیست یا منقضی شده است."

msgid "The Google sign-in settings are incomplete."
msgstr "تنظیمات ورود گوگل کامل نیست."

msgid "The OAuth 2.0 client ID from Google Cloud Console."
msgstr "شناسه OAuth 2.0 از Google Cloud Console."

msgid "The SMS message was not accepted by %s."
msgstr "ارسال پیامک توسط %s پذیرفته نشد."

msgid "The SMS provider did not accept this message."
msgstr "سرویس پیامک این پیام را نپذیرفت."

msgid "The SMS provider returned an unsuccessful response (HTTP %d)."
msgstr "سرویس پیامک پاسخ ناموفق داد (HTTP %d)."

msgid "The code is invalid or has expired."
msgstr "کد نامعتبر یا منقضی شده است."

msgid "The code is invalid, expired or unavailable. Check the number and latest code, or request a new code."
msgstr "کد نامعتبر، منقضی یا غیرقابل استفاده است. شماره و آخرین کد را بررسی کنید یا کد جدید بخواهید."

msgid "The code, recovery page and unsubscribe link must be included in the recovery parameter mapping (or custom message). Use templates approved for purchase reminders."
msgstr "کد، آدرس صفحه بازیابی و لینک لغو دریافت باید در نگاشت متغیرها یا متن درگاه سفارشی قرار بگیرند. از قالب تأییدشده یادآوری خرید استفاده کنید."

msgid "The custom gateway JSON parameters are not valid JSON."
msgstr "پارامترهای JSON درگاه سفارشی معتبر نیستند."

msgid "The custom gateway must use the {message} placeholder for commerce messages."
msgstr "درگاه سفارشی باید برای پیام فروشگاه از جای‌نگهدار {message} استفاده کند."

msgid "The email could not be sent. Please check the site email settings."
msgstr "ارسال ایمیل ناموفق بود. تنظیمات ایمیل سایت را بررسی کنید."

msgid "The login code could not be created."
msgstr "امکان ساخت کد ورود وجود ندارد."

msgid "The login code could not be sent. Please try again later."
msgstr "ارسال کد ورود ناموفق بود. لطفاً کمی بعد دوباره تلاش کنید."

msgid "The page that contains the [anar_account] shortcode."
msgstr "صفحه‌ای که شورت‌کد [anar_account] در آن قرار دارد."

msgid "The password reset code is invalid, expired or unavailable."
msgstr "کد بازنشانی رمز نادرست، منقضی یا در دسترس نیست."

msgid "The passwords do not match."
msgstr "رمزهای عبور یکسان نیستند."

msgid "The preview expired or bulk messages are disabled. Preview again before launching."
msgstr "پیش‌نمایش منقضی شده یا ارسال گروهی غیرفعال است. پیش از اجرا دوباره پیش‌نمایش بگیرید."

msgid "The primary color of the sign-in form and account dashboard."
msgstr "رنگ اصلی فرم ورود و پنل کاربری."

msgid "The product you requested is back in stock."
msgstr "کالایی که منتظرش بودید دوباره موجود شده است."

msgid "The recovery code and unsubscribe link must be included in the recovery parameter mapping (or custom message). Use templates approved for purchase reminders."
msgstr "کد بازیابی و لینک لغو دریافت باید در نگاشت متغیرها یا متن درگاه سفارشی قرار بگیرند. از قالب تأییدشده یادآوری خرید استفاده کنید."

msgid "The recovery discount does not match the order billing phone."
msgstr "تخفیف بازیابی با شمارهٔ همراه صورتحساب سفارش مطابقت ندارد."

msgid "The request form appears on out-of-stock product pages. The customer verifies their mobile number and selects a product or variation. One notification is queued when that item becomes available."
msgstr "فرم درخواست در صفحهٔ کالای ناموجود نمایش داده می‌شود. مشتری شمارهٔ همراه خود را تأیید و کالا یا متغیر مورد نظر را انتخاب می‌کند. پس از تأمین موجودی، یک اعلان در صف قرار می‌گیرد."

msgid "The request is invalid."
msgstr "درخواست نامعتبر است."

msgid "The right words, at the right time."
msgstr "پیام مناسب، در زمان مناسب."

msgid "The saved cart could not be restored. Your previous cart has been kept."
msgstr "بازیابی سبد انجام نشد. سبد قبلی شما حفظ شد."

msgid "The saved cart is empty."
msgstr "سبد ذخیره‌شده خالی است."

msgid "The selected SMS provider is unavailable."
msgstr "درگاه پیامک انتخاب‌شده در دسترس نیست."

msgid "The selected commerce SMS provider is unavailable."
msgstr "سرویس پیامکی منتخب فروشگاه در دسترس نیست."

msgid "The sign-in request address has changed."
msgstr "نشانی درخواست ورود تغییر کرده است."

msgid "The store quiz is not configured yet."
msgstr "مسابقهٔ فروشگاه هنوز تنظیم نشده است."

msgid "The verification code is invalid or expired."
msgstr "کد تأیید نامعتبر یا منقضی است."

msgid "The verification step expired. Please sign in again."
msgstr "مهلت مرحلهٔ تأیید تمام شد. لطفاً دوباره وارد شوید."

msgid "Third inactivity reminder"
msgstr "یادآوری سوم عدم خرید"

msgid "This account cannot sign in."
msgstr "امکان ورود با این حساب وجود ندارد."

msgid "This account uses two-step verification, so XML-RPC sign-in is disabled."
msgstr "این حساب از ورود دومرحله‌ای استفاده می‌کند، بنابراین ورود از طریق XML-RPC غیرفعال است."

msgid "This campaign has already been queued."
msgstr "این کمپین قبلاً در صف قرار گرفته است."

msgid "This document reflects the current order and payment status. Use your browser print dialog to print it or save it as PDF."
msgstr "این سند وضعیت فعلی سفارش و پرداخت را نشان می‌دهد. از پنجرهٔ چاپ مرورگر برای چاپ یا ذخیره به صورت PDF استفاده کنید."

msgid "This game expired. Try again when your next play is available."
msgstr "این بازی منقضی شده است. در نوبت مجاز بعدی دوباره امتحان کنید."

msgid "This game is unavailable."
msgstr "این بازی در دسترس نیست."

msgid "This invoice link is invalid, expired or does not belong to you."
msgstr "پیوند این صورتحساب نامعتبر، منقضی یا متعلق به شما نیست."

msgid "This link is invalid or expired."
msgstr "این پیوند نامعتبر یا منقضی است."

msgid "This number has stopped messages. Contact the store to change that preference."
msgstr "این شماره دریافت پیام را متوقف کرده است. برای تغییر این انتخاب با فروشگاه تماس بگیرید."

msgid "This play has already been reserved. Reload before starting another."
msgstr "این نوبت بازی قبلاً رزرو شده است. پیش از شروع نوبت دیگر، صفحه را تازه کنید."

msgid "This preview supports up to 10,000 contacts. Narrow the audience before launching a larger campaign."
msgstr "این پیش‌نمایش حداکثر ۱۰٬۰۰۰ مخاطب را پشتیبانی می‌کند. برای کمپین بزرگ‌تر، گروه مخاطبان را محدودتر کنید."

msgid "This purchase no longer needs a reminder, or its link has expired."
msgstr "این خرید دیگر به یادآوری نیاز ندارد یا لینک آن منقضی شده است."

msgid "This recovery discount is valid only for the mobile number that received it. Enter that billing phone before applying it."
msgstr "این تخفیف فقط برای شمارهٔ همراه دریافت‌کننده معتبر است. پیش از اعمال آن، همان شماره را در صورتحساب وارد کنید."

msgid "This reminder link is invalid or has expired."
msgstr "لینک یادآوری نامعتبر یا منقضی شده است."

msgid "This stops future campaign and abandoned-cart reminders for your number. Payment and shipment service notices are separate."
msgstr "این کار کمپین‌ها و یادآوری سبد رهاشده را برای شمارهٔ شما متوقف می‌کند. اعلان‌های خدماتی پرداخت و مرسوله مستقل هستند."

msgid "This subscription is not available."
msgstr "ثبت این درخواست در دسترس نیست."

msgid "This survey is no longer available."
msgstr "این نظرسنجی دیگر در دسترس نیست."

msgid "Too many incorrect attempts. Please request a new code."
