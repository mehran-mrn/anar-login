msgstr "ارتباط با سرویس پیامک برقرار نشد."

msgid "Could not connect. Please try again."
msgstr "ارتباط برقرار نشد؛ دوباره تلاش کنید."

msgid "Could not obtain sign-in authorization from Google."
msgstr "دریافت مجوز ورود از گوگل ناموفق بود."

msgid "Could not retrieve the Google profile."
msgstr "دریافت پروفایل گوگل ناموفق بود."

msgid "Create a new account when a verified user does not already have one."
msgstr "اگر کاربر پس از تأیید کد حسابی نداشت، حساب تازه‌ای برای او ساخته شود."

msgid "Create accounts automatically"
msgstr "ساخت خودکار حساب"

