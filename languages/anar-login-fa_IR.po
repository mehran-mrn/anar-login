msgid "Endpoint URL"
msgstr "آدرس وب‌سرویس"

msgid "Enter a template body ID, or a sender number for plain-text messages."
msgstr "کد الگو (bodyId) را وارد کنید، یا برای ارسال متن ساده شمارهٔ فرستنده را."

msgid "Enter the code we sent to %s."
msgstr "کدی را که به %s ارسال شد وارد کنید."

msgid "Enter the complete verification code."
msgstr "کد تأیید را کامل وارد کنید."

msgid "Enter the verification code"
msgstr "کد تأیید را وارد کنید"

msgid "Enter your email address and we will send you a one-time password."
msgstr "ایمیل خود را وارد کنید؛ رمز یک‌بارمصرف برایتان ارسال می‌شود."

msgid "Enter your email address."
msgstr "ایمیل را وارد کنید."

msgid "Enter your mobile number and we will text you a one-time password."
msgstr "شماره موبایل خود را وارد کنید؛ رمز یک‌بارمصرف برایتان پیامک می‌شود."

msgid "Enter your mobile number or email address and we will send you a one-time password."
msgstr "شماره موبایل یا ایمیل خود را وارد کنید؛ رمز یک‌بارمصرف برایتان ارسال می‌شود."

msgid "Enter your mobile number or email address."
msgstr "شماره موبایل یا ایمیل را وارد کنید."

msgid "Enter your mobile number."
msgstr "شماره موبایل را وارد کنید."

