msgstr "توکن یا کلید دسترسی Edge API"

msgid "Email"
msgstr "ایمیل"

msgid "Email is sent with the standard wp_mail function and is compatible with SMTP plugins."
msgstr "ارسال با تابع استاندارد wp_mail انجام می‌شود و با افزونه‌های SMTP سازگار است."

